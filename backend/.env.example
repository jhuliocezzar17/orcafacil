# Banco PostgreSQL (Neon). Copie os valores da aba "Environment Variables" do projeto na Vercel
DATABASE_URL="postgresql://usuario:senha@host-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/neondb?sslmode=require"

# Chave que assina os tokens JWT (invente uma frase longa)
JWT_SECRET="troque-por-uma-chave-secreta-longa"
